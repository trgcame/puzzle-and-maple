@Component
script UIComboCount extends Component

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.Entity.Enable = false
		self._T.active  = false
		self._T.holding = false
		
		-- 자식 D0(십의 자리), D1(일의 자리) 엔티티 참조
		self._T.digits = {}
		for i = 0, 1 do
			self._T.digits[i + 1] = self.Entity:GetChildByName("D" .. tostring(i))
		end
		
		-- animationclip 02fc48d07e424cdda30e251b96fab35f 의 프레임별 sprite RUID (0~9)
		self._T.digitRUIDs = {
			"8bd26bbaaf53496a88406c3182130c9d",
			"5c9957cfeca2441a82ad0b3c81005d50",
			"00f608bccc744d09b95353883a134f70",
			"d119cd452cc54363a0820a659063ea13",
			"52c96eac69b948e98294d53f3e64a3db",
			"db7dae4e2a7e4fda951bed728606370d",
			"907a2a08bbb24b07924b48f81ae3426d",
			"c5664e28a77b438badb33d09cb5355cd",
			"bafc4971a6574e639f6379975bcc103d",
			"9598c0b650fc44ce86caaf604eb63ec2",
		}
		
		-- combo 레이블 자식 참조 (고정 위치에서 나타났다 사라짐)
		self._T.comboLabel = self.Entity:GetChildByName("Combo")
		local clEnt = self._T.comboLabel
		if isvalid(clEnt) then clEnt.Enable = false end
		
		-- x 스프라이트 자식 참조 및 초기화
		self._T.xMult = self.Entity:GetChildByName("X")
		local xEnt = self._T.xMult
		if isvalid(xEnt) then
			local spr = xEnt.SpriteGUIRendererComponent
			if spr ~= nil then
				spr.ImageRUID = DataRef("a20af8f23e3249f691d03da880f418ca")
				spr.Color = Color(1, 1, 1, 1)
			end
		end
		
		-- 엔티티의 기준 위치 저장 (Play 호출마다 이 위치에서 시작)
		local rc = self.Entity.UITransformComponent
		if rc ~= nil then
			self._T.originPos = rc.anchoredPosition
		else
			self._T.originPos = Vector2(0, 0)
		end
	end

	@ExecSpace("ClientOnly")
	method void Play(integer comboCount)
		local s    = tostring(math.max(1, comboCount))
		local n    = #s
		local digitW = 28
		local digits = self._T.digits or {}
		local ruids  = self._T.digitRUIDs or {}
		
		-- x 스프라이트 (너비 20px) 위치: 전체 그룹 왼쪽에 배치
		local xW  = 60
		local xEnt = self._T.xMult
		if isvalid(xEnt) then
			local xRc = xEnt.UITransformComponent
			if xRc ~= nil then
				-- 1자리: x(-14) D1(10) / 2자리: x(-28) D0(-4) D1(24)
				xRc.anchoredPosition = Vector2(n < 2 and (-digitW / 2) or (-digitW), 0)
			end
			local xSpr = xEnt.SpriteGUIRendererComponent
			if xSpr ~= nil then xSpr.Color = Color(1, 1, 1, 1) end
			xEnt.Enable = true
		end
		
		for slot = 1, 2 do
			local ent = digits[slot]
			if not isvalid(ent) then continue end
		
			if slot == 1 and n < 2 then
				-- 1자리 수: 십의 자리(D0) 숨김
				ent.Enable = false
			else
				-- slot 1 → 십의 자리 (n>=2), slot 2 → 일의 자리
				local charIdx = (slot == 1) and 1 or n
				local d = tonumber(s:sub(charIdx, charIdx)) or 0
		
				local spr = ent.SpriteGUIRendererComponent
				if spr ~= nil then
					spr.ImageRUID = DataRef(ruids[d + 1] or "")
					spr.Color = Color(1, 1, 1, 1)
				end
		
				local rc = ent.UITransformComponent
				if rc ~= nil then
					-- x prefix 20px 만큼 오른쪽으로 보정
					local offsetX
					if n >= 2 then
						offsetX = (slot == 1) and (xW/2 - digitW/2) or (xW/2 + digitW/2)
					else
						offsetX = xW / 2
					end
					rc.anchoredPosition = Vector2(offsetX, 0)
				end
				ent.Enable = true
			end
		end
		
		-- combo 레이블 표시 (고정 위치, 알파만 초기화)
		local clEnt = self._T.comboLabel
		if isvalid(clEnt) then
			local clSpr = clEnt.SpriteGUIRendererComponent
			if clSpr ~= nil then clSpr.Color = Color(1, 1, 1, 1) end
			clEnt.Enable = true
		end
		
		-- 위치·알파 초기화 후 표시
		local myRC = self.Entity.UITransformComponent
		if myRC ~= nil then
			myRC.anchoredPosition = self._T.originPos or Vector2(0, 0)
		end
		self.Entity.Enable = true
		self._T.active  = true
		self._T.holding = false
		self._T.elapsed = 0
	end

	@ExecSpace("ClientOnly")
	method void Hold()
		-- **최종 콤보를 붙잡아 둔다**(2026-09-07 사용자 요청). 캐스케이드가 끝난 뒤 호출하면
		-- 페이드아웃 없이 그대로 남아 있고, `Hide()`가 올 때까지 유지된다.
		-- 🔴 `Play()`가 매번 `holding`을 false로 되돌리므로, 다음 콤보가 떠도 정상 동작한다.
		if not (self._T.active or false) then return end
		self._T.holding = true
		self._T.elapsed = 0.1  -- POP 구간을 지나 유지 구간에 머무르게 한다
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		-- 즉시 숨긴다. 몬스터 턴 시작(TurnManager:StartEnemyTurn)에서 호출된다.
		self._T.active  = false
		self._T.holding = false
		self.Entity.Enable = false
		local clEnt = self._T.comboLabel
		if isvalid(clEnt) then clEnt.Enable = false end
	end

	method void OnUpdate(number delta)
		if not (self._T.active or false) then return end
		
		local POP_DUR  = 0.1  -- 팝업 올라가는 시간
		local HOLD_DUR = 0.8   -- 유지 시간
		local FADE_DUR = 0.35  -- 페이드 아웃 시간
		local POP_H    = 10    -- 올라가는 높이 (px)
		
		-- 붙잡힌 상태에서는 시간을 흘리지 않는다 — 위치도 알파도 유지 구간에서 멈춘다.
		if not (self._T.holding or false) then
			self._T.elapsed = (self._T.elapsed or 0) + delta
		end
		local elapsed = self._T.elapsed

		if (not (self._T.holding or false)) and elapsed >= POP_DUR + HOLD_DUR + FADE_DUR then
			self.Entity.Enable = false
			self._T.active = false
			local clEnt = self._T.comboLabel
			if isvalid(clEnt) then clEnt.Enable = false end
			return
		end
		
		-- Y 위치: 팝업 구간만 이동, 이후 고정
		local origin = self._T.originPos or Vector2(0, 0)
		local myRC = self.Entity.UITransformComponent
		if myRC ~= nil then
			local yOffset
			if elapsed < POP_DUR then
				local t = elapsed / POP_DUR
				local ease = 1 - (1 - t) * (1 - t)  -- ease-out quad
				yOffset = POP_H * ease
			else
				yOffset = POP_H
			end
			myRC.anchoredPosition = Vector2(origin.x, origin.y + yOffset)
		end
		
		-- 알파: 유지 구간까지 1, 이후 페이드 아웃
		local alpha
		if self._T.holding or false then
			alpha = 1.0
		elseif elapsed > POP_DUR + HOLD_DUR then
			alpha = math.max(0, 1.0 - (elapsed - POP_DUR - HOLD_DUR) / FADE_DUR)
		else
			alpha = 1.0
		end
		
		local digits = self._T.digits or {}
		for i = 1, 2 do
			local ent = digits[i]
			if isvalid(ent) and ent.Enable then
				local spr = ent.SpriteGUIRendererComponent
				if spr ~= nil then spr.Color = Color(1, 1, 1, alpha) end
			end
		end
		local xEnt = self._T.xMult
		if isvalid(xEnt) and xEnt.Enable then
			local spr = xEnt.SpriteGUIRendererComponent
			if spr ~= nil then spr.Color = Color(1, 1, 1, alpha) end
		end
		local clEnt = self._T.comboLabel
		if isvalid(clEnt) and clEnt.Enable then
			local spr = clEnt.SpriteGUIRendererComponent
			if spr ~= nil then spr.Color = Color(1, 1, 1, alpha) end
		end
	end

end