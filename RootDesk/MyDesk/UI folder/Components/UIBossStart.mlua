@Component
script UIBossStart extends Component

	property string BossId = "seasonboss_1"

	@EventSender("Self")
	handler HandleButtonClickEvent(ButtonClickEvent event)
		--------------- Native Event Sender Info ----------------
		-- Sender: ButtonComponent
		-- Space: Client
		---------------------------------------------------------
		local mgrEnt = _EntityService:GetEntityByPath("/common/Manager/SeasonBossManager")
		if isvalid(mgrEnt) then
			mgrEnt.SeasonBossManager:TryStartBossBattle(self.BossId)
		end
	end

end