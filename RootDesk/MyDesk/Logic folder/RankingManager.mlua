@Logic
script RankingManager extends Logic

	method void OnBeginPlay()
		if self:IsServer() then
			self._T.bestCache      = {}   -- boardId -> userId -> 마지막으로 저장소에 쓴 점수
			self._T.pendingSubmit  = {}   -- boardId -> userId -> 아직 안 쓴 최고 점수
			-- 제출을 60초 단위로 묶는다. 스테이지 랭킹은 클리어마다 갱신되는데
			-- 매번 쓰면 DataStorage 비용이 스테이지 수만큼 나간다. 최고 기록 방식이라
			-- 중간값을 건너뛰어도 결과가 같으므로 주기 flush로 합쳐도 손실이 없다.
			self._T.rankFlushTimer = _TimerService:SetTimerRepeat(function()
				self:_FlushSubmits()
			end, 60.0)
		else
			self._T.cache = {}        -- boardId -> { rows = {...}, myRank = n, myScore = n }
			self._T.pending = {}      -- boardId -> true (요청 진행 중)
		end
	end

	method void OnEndPlay()
		-- ⚠️ **여기서 저장하지 않는다.** MSW 공식 가이드: `OnEndPlay`에서 `SetAndWait`/`SetAsync`를
		--    호출하면 유저가 재입장할 때 **이전 저장이 제대로 로드되지 않을 수 있다.**
		--    저장은 아래 `UserLeaveEvent` 핸들러가 맡는다. 여기서는 타이머만 정리한다.
		if self:IsServer() then
			if self._T.rankFlushTimer ~= nil then
				_TimerService:ClearTimer(self._T.rankFlushTimer)
			end
		end
	end

	-- 시즌보스 랭킹은 **3일마다 초기화**된다(2026-09-06 확정 — GDD §8).
	-- 저장소를 지우는 대신 **보드 이름에 시즌 번호를 붙여 새 보드로 넘어간다.**
	-- 지난 시즌 보드가 그대로 남으므로 **시즌 종료 후 순위를 다시 읽어 보상을 줄 수 있다**(D1b).
	-- 스테이지 랭킹은 통산 기록이라 시즌을 붙이지 않는다.
	method integer GetSeasonNumber()
		-- 3일(259,200초) 단위 블록. epoch 기준이라 서버가 상태를 들고 있을 필요가 없고
		-- 어느 서버에서 계산해도 같은 값이 나온다.
		return math.floor(os.time() / 259200)
	end

	method string BossStorageNameForSeason(integer season)
		return "boss_rank_s" .. tostring(season)
	end

	method string _StorageName(string boardId)
		if boardId == "boss" then return self:BossStorageNameForSeason(self:GetSeasonNumber()) end
		return "stage_rank"
	end

	@ExecSpace("ServerOnly")
	method string _NicknameOf(string userId)
		-- 표시용 이름. 접속 중이 아니면 알 수 없으므로 그때는 빈 값으로 두고
		-- 클라이언트가 "???"로 대체한다(다음 갱신 때 채워진다).
		local e = _UserService:GetUserEntityByUserId(userId)
		if isvalid(e) and e.PlayerComponent ~= nil then
			return e.PlayerComponent.Nickname or ""
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method integer _KnownBest(string storageName, string userId)
		-- 서버가 기억하는 이 유저의 마지막 제출 점수. 없으면 -1.
		-- 이게 있으면 DataStorage **읽기를 건너뛸 수 있다** — 스테이지마다 제출하는 구조에서
		-- 읽기 비용이 쓰기만큼 나가던 것을 없앤다. 서버가 내려가면 캐시도 비므로
		        -- 그때 한 번만 실제로 읽는다(정확성은 유지, 비용만 줄어든다).
		-- ⚠️ 키는 `boardId`가 아니라 **저장소 이름**이다. 시즌보스 보드는 3일마다 이름이 바뀌는데
		--    boardId로 캐싱하면 **새 시즌 보드에 옛 시즌 최고점이 그대로 적용돼 쓰기가 막힌다.**
		if self._T.bestCache == nil then self._T.bestCache = {} end
		local byBoard = self._T.bestCache[storageName]
		if byBoard == nil then return -1 end
		return byBoard[userId] or -1
	end

	@ExecSpace("ServerOnly")
	method void _RememberBest(string storageName, string userId, integer score)
		if self._T.bestCache == nil then self._T.bestCache = {} end
		if self._T.bestCache[storageName] == nil then self._T.bestCache[storageName] = {} end
		self._T.bestCache[storageName][userId] = score
	end

	@ExecSpace("Server")
	method void RequestSubmit(string boardId, integer score)
		-- 점수 접수. **여기서는 저장소를 건드리지 않는다** — 대기열에 최고값만 남기고
		-- 실제 쓰기는 60초 주기 flush · 유저 퇴장 · 서버 종료 시점에 한 번씩 일어난다.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if score == nil or score <= 0 then return end
		
		-- 이미 저장된 기록보다 낮으면 대기열에도 넣지 않는다(DataStorage 접근 0).
		if self:_KnownBest(self:_StorageName(boardId), userId) >= score then return end
		
		if self._T.pendingSubmit == nil then self._T.pendingSubmit = {} end
		if self._T.pendingSubmit[boardId] == nil then self._T.pendingSubmit[boardId] = {} end
		local queued = self._T.pendingSubmit[boardId][userId] or -1
		if score > queued then
			self._T.pendingSubmit[boardId][userId] = score
		end
	end

	@ExecSpace("ServerOnly")
	method void _FlushSubmits()
		-- 대기 중인 모든 유저의 점수를 저장소에 반영한다.
		if self._T.pendingSubmit == nil then return end
		for boardId, byUser in pairs(self._T.pendingSubmit) do
			for userId, score in pairs(byUser) do
				self:_WriteSubmit(boardId, userId, score)
			end
			self._T.pendingSubmit[boardId] = {}
		end
	end

	@ExecSpace("ServerOnly")
	method void _FlushSubmitsFor(string userId)
		-- 한 유저 몫만 반영한다(퇴장 시). 대기 중인 게 없으면 아무 일도 하지 않는다.
		if userId == nil or userId == "" then return end
		if self._T.pendingSubmit == nil then return end
		for boardId, byUser in pairs(self._T.pendingSubmit) do
			local score = byUser[userId]
			if score ~= nil then
				self:_WriteSubmit(boardId, userId, score)
				byUser[userId] = nil
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void _WriteSubmit(string boardId, string userId, integer score)
		-- 실제 저장소 쓰기. 기존 점수보다 높을 때만 쓴다(최고 기록 방식).
		-- 저장소 이름은 한 번만 구해 캐시 키와 실제 저장소 양쪽에 같은 값을 쓴다
		-- (시즌보스 보드는 3일마다 이름이 바뀌므로 둘이 어긋나면 안 된다).
		local sname = self:_StorageName(boardId)
		local known = self:_KnownBest(sname, userId)
		if known >= score then return end

		local storage = _DataStorageService:GetSortableDataStorage(sname)
		if storage == nil then
			log_error("[Ranking] 저장소를 열 수 없습니다: " .. tostring(sname))
			return
		end

		-- 캐시에 없을 때(서버 재시작 직후 · 새 시즌 첫 쓰기)만 실제로 읽어 확인한다.
		local prev = known
		if known < 0 then
			local code, stored = storage:GetAndWait(userId)
			if code == 0 and stored ~= nil then prev = stored end
			if prev >= score then
				self:_RememberBest(sname, userId, prev)
				log("[Ranking] " .. sname .. " 갱신 없음 (기존 " .. tostring(prev) .. " >= " .. tostring(score) .. ")")
				return
			end
		end
		
		-- 닉네임을 Tag에 실어 저장한다. Tag가 길수록 저장 용량을 먹으므로 이름만 넣는다.
		local info = DataStorageKeyInfo(userId, "", self:_NicknameOf(userId))
		local kv = {}
		kv[info] = score
		-- BatchSetByInfoAndWait는 (코드, 실패한 키 목록) 두 값을 돌려준다.
		-- 한 변수로 받으면 LWA-1111 UnbalancedAssignment가 뜬다.
		local setCode, failedKeys = storage:BatchSetByInfoAndWait(kv)
		if setCode == 0 then
			self:_RememberBest(sname, userId, score)
		end
		log("[Ranking] " .. sname .. " 저장 userId=" .. tostring(userId)
			.. " " .. tostring(prev) .. " → " .. tostring(score) .. " code=" .. tostring(setCode))
	end

	@ExecSpace("ServerOnly")
	method integer GetRankInBossSeason(integer season, string userId)
		-- 지난 시즌 보스 보드에서 이 유저의 순위(1-based)를 돌려준다. 기록이 없으면 0.
		-- 시즌 보상 정산(D1b) 전용 — 보드를 지우지 않고 이름만 바꿔 두기 때문에 가능하다.
		if userId == nil or userId == "" then return 0 end
		local storage = _DataStorageService:GetSortableDataStorage(self:BossStorageNameForSeason(season))
		if storage == nil then return 0 end

		-- `RequestBoard`와 같은 이유로 **점수 전 구간**을 받아 앞에서부터 센다
		-- (min/max는 순위 범위가 아니라 점수 범위다).
		local code, pages = storage:GetSortedAndWait(SortDirection.Descending, 1, 2147483647)
		if code ~= 0 or pages == nil then return 0 end
		local datas = pages:GetCurrentPageDatas()
		if datas == nil then return 0 end

		local rank = 0
		for _, item in pairs(datas) do
			rank += 1
			if item.KeyInfo.Key == userId then return rank end
		end
		return 0
	end

	@ExecSpace("Server")
	method void RequestBoard(string boardId, integer topCount)
		-- 상위 N명 + 내 점수를 한 번에 받아 클라이언트로 보낸다.
		-- 호출마다 DataStorage를 읽으므로 UI에서 연타로 부르지 않게 할 것.
		local userId = senderUserId
		local storage = _DataStorageService:GetSortableDataStorage(self:_StorageName(boardId))
		if storage == nil then
			self:ReceiveBoard(boardId, "[]", 0, 0, userId)
			return
		end
		
		local n = topCount
		if n == nil or n <= 0 then n = 10 end
		
		-- ⚠️ GetSortedAndWait의 min/max는 "순위 범위"가 아니라 **점수 범위**다.
		-- (1, 10)으로 부르면 점수 7은 잡히고 123456은 빠진다 — 실제로 겪은 버그.
		-- 전 구간을 받아 앞에서 n명만 자른다.
		local rows = {}
		local code, pages = storage:GetSortedAndWait(SortDirection.Descending, 1, 2147483647)
		if code == 0 and pages ~= nil then
			local datas = pages:GetCurrentPageDatas()
			if datas ~= nil then
				local rank = 0
				for _, item in pairs(datas) do
					if rank >= n then break end
					rank += 1
					table.insert(rows, {
						rank  = rank,
						key   = item.KeyInfo.Key,
						name  = item.KeyInfo.Tag,
						score = item.Value,
					})
				end
			end
		end
		
		-- 내 점수. 순위는 상위 목록 안에 있으면 그 값, 없으면 0(= 순위권 밖)으로 둔다.
		local myScore = 0
		local myCode, mine = storage:GetAndWait(userId)
		if myCode == 0 and mine ~= nil then myScore = mine end
		local myRank = 0
		for _, r in ipairs(rows) do
			if r.key == userId then myRank = r.rank break end
		end
		
		-- 빈 테이블을 JSONEncode하면 JSONDecode가 못 읽는 문자열이 나온다
		-- (증상: "Error reading JToken from JsonReader"). 빈 목록은 "[]"로 직접 보낸다.
		local json = "[]"
		if #rows > 0 then json = _HttpService:JSONEncode(rows) end
		self:ReceiveBoard(boardId, json, myRank, myScore, userId)
	end

	@ExecSpace("Client")
	method void ReceiveBoard(string boardId, string rowsJson, integer myRank, integer myScore)
		local rows = {}
		if rowsJson ~= nil and rowsJson ~= "" and rowsJson ~= "[]" then
			local decoded = _HttpService:JSONDecode(rowsJson)
			if decoded ~= nil then rows = decoded end
		end
		if self._T.cache == nil then self._T.cache = {} end
		self._T.cache[boardId] = { rows = rows, myRank = myRank, myScore = myScore }
		if self._T.pending ~= nil then self._T.pending[boardId] = nil end
		log("[Ranking] " .. boardId .. " 수신 " .. tostring(#rows) .. "명 / 내 순위 "
			.. tostring(myRank) .. " 점수 " .. tostring(myScore))
		_RankingUI:OnBoardReceived(boardId)
	end

	@ExecSpace("ClientOnly")
	method any GetBoard(string boardId)
		if self._T.cache == nil then return nil end
		return self._T.cache[boardId]
	end

	@ExecSpace("ClientOnly")
	method void Fetch(string boardId, integer topCount)
		-- 같은 보드를 응답 전에 다시 부르지 않는다(DataStorage 호출 절약).
		if self._T.pending == nil then self._T.pending = {} end
		if self._T.pending[boardId] == true then return end
		self._T.pending[boardId] = true
		self:RequestBoard(boardId, topCount)
	end

	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		-- 나가는 유저의 대기 점수를 즉시 확정한다. 주기 flush만 믿으면
		-- 마지막 60초 구간의 기록이 날아간다.
		-- MSW 공식 가이드가 DataStorage 저장을 **이 핸들러에서** 하라고 지정한 자리다.
		if not self:IsServer() then return end
		self:_FlushSubmitsFor(event.UserId)
	end

end