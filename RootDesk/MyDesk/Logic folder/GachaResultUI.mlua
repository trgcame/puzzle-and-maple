@Logic
script GachaResultUI extends Logic

	property Entity panel1 = "be000f83-8db3-41a4-97a4-77a988ea4cbd"

	property Entity panel10 = "457acad2-0039-47b3-b8c4-4ea741bc39d5"

	property Entity probabilityPopup = "726c6deb-2f23-4c47-bcb2-6182374a53ec"

	property Entity btnShowProbability = "beac60c9-0598-4fb4-b137-ebe645e72f70"

	property string mesoIconRUID = "fd255d50cb5177545a0e71c4a84363c7"

	property string stoneIconRUID = "45820819ebec483fb5cc98b7ccb420f1"

	-- ★5 중복 영웅이 티켓으로 바뀌어 나올 때 쓰는 아이콘(로비 헤더 티켓과 같은 RUID).
	property string ticketIconRUID = "059ccd33e9ff4fcbbeaf69329205fb45"

	-- 10연차 슬롯 테두리. 보상 종류·등급에 따라 갈아 끼운다.
	-- 값의 출처는 사용자가 Maker에서 Slot1(재화) · Slot2(SSR) · Slot3(SR)에 넣어둔 프레임이다.
	property string frameCurrencyRUID = "908e27089a814fcbad97ccfa33ce47fc"

	property string frameSSRRUID = "6c72208ec43f45749da205f0877fda8e"

	property string frameSRRUID = "7130fe05903446e4969f12b1fc91b4f8"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 결과 패널·확률 팝업은 항상 닫힌 상태로 시작한다.
		-- 버튼은 여기서 한 번만 연결하고 OnEndPlay에서 해제한다.
		self._T.handlers = {}
		self:_Hide(self.panel1)
		self:_Hide(self.panel10)
		self:_Hide(self.probabilityPopup)

		self:_Bind(self:_Child(self.panel1, "BtnConfirm"), function() self:Close() end)
		self:_Bind(self:_Child(self.panel10, "BtnConfirm"), function() self:Close() end)
		self:_Bind(self:_Child(self.probabilityPopup, "BtnClose"), function() self:CloseProbability() end)
		self:_Bind(self.btnShowProbability, function() self:ShowProbability() end)
		log("[GachaResultUI] 초기화 완료")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._T.handlers == nil then return end
		for _, rec in ipairs(self._T.handlers) do
			if isvalid(rec.entity) then
				rec.entity:DisconnectEvent(ButtonClickEvent, rec.evtHandler)
			end
		end
		self._T.handlers = {}
	end

	@ExecSpace("ClientOnly")
	method void _Bind(Entity entity, any callback)
		-- 버튼 클릭 구독. 해제용으로 핸들러를 모아둔다.
		if not isvalid(entity) then
			log_warning("[GachaResultUI] 버튼 엔티티를 찾을 수 없어 배선을 건너뜁니다.")
			return
		end
		local h = entity:ConnectEvent(ButtonClickEvent, callback)
		table.insert(self._T.handlers, { entity = entity, evtHandler = h })
	end

	@ExecSpace("ClientOnly")
	method any _Child(Entity parent, string name)
		-- 자식 조회 헬퍼. UUID를 70개 주입하는 대신 이름으로 찾는다.
		if not isvalid(parent) then return nil end
		return parent:GetChildByName(name, true)
	end

	@ExecSpace("ClientOnly")
	method void _Hide(Entity entity)
		if isvalid(entity) then entity.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void _SetText(Entity parent, string childName, string value)
		local e = self:_Child(parent, childName)
		if not isvalid(e) then return end
		local c = e.TextGUIRendererComponent
		if c ~= nil then c.Text = value end
	end

	@ExecSpace("ClientOnly")
	method void _SetSprite(Entity parent, string childName, string ruid)
		local e = self:_Child(parent, childName)
		if not isvalid(e) then return end
		local c = e.SpriteGUIRendererComponent
		if c == nil then return end
		if ruid == nil or ruid == "" then
			e.Enable = false
		else
			e.Enable = true
			c.ImageRUID = ruid
		end
	end

	@ExecSpace("ClientOnly")
	method void _SetIcon(Entity parent, string childName, any d, number heroScale, number coinSize)
		-- 영웅은 로비 Center/HeroThumnail과 같은 방식으로 그린다:
		-- 원본 크기 유지(NativeSize) + LocalScale 축소 + CSV의 LocalX/LocalY 보정.
		-- RectSize로 늘리면 전신 이미지가 찌그러지므로 쓰지 않는다.
		-- 재화 아이콘은 정사각이라 기존대로 RectSize로 크기를 준다.
		self:_SetSprite(parent, childName, d.icon)
		local e = self:_Child(parent, childName)
		if not isvalid(e) then return end
		local c = e.SpriteGUIRendererComponent
		local t = e.UITransformComponent
		if c == nil or t == nil then return end
		if d.isHero then
			c.PreserveSprite = PreserveSpriteType.NativeSize
			c.LocalScale = Vector2(heroScale, heroScale)
			-- 오프셋은 로비 배율(0.6) 기준으로 잡힌 값이라 현재 배율로 환산한다.
			local k = heroScale / 0.6
			c.LocalPosition = Vector2((d.localX or 0) * k, (d.localY or 0) * k)
		else
			c.PreserveSprite = PreserveSpriteType.None
			c.LocalScale = Vector2(1, 1)
			c.LocalPosition = Vector2(0, 0)
			t.RectSize = Vector2(coinSize, coinSize)
		end
	end

	@ExecSpace("ClientOnly")
	method string _SampleHeroThumbnail(string rarity)
		-- 확률표의 등급 행에 얼굴을 하나 얹어준다. 해당 등급의 첫 영웅 썸네일.
		local count = _DataService:GetRowCount("HeroSet")
		for i = 1, count do
			if _DataService:GetCell("HeroSet", i, "Rarity") == rarity then
				return _DataService:GetCell("HeroSet", i, "ThumnailRUID") or ""
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void _SetSlotFrame(Entity slot, any d)
		-- 슬롯 테두리를 보상에 맞춰 교체한다. 재화 / SSR 영웅 / 그 외 영웅(SR) 3종.
		-- 새 등급이 생기면 SR용 프레임으로 떨어진다.
		local c = slot.SpriteGUIRendererComponent
		if c == nil then return end
		local ruid = self.frameCurrencyRUID
		if d.isHero then
			if d.rarity == "SSR" then
				ruid = self.frameSSRRUID
			else
				ruid = self.frameSRRUID
			end
		end
		if ruid ~= nil and ruid ~= "" then c.ImageRUID = ruid end
	end

	@ExecSpace("ClientOnly")
	method table _Describe(any item)
		-- 보상 1건을 화면 표시용으로 정규화한다. 영웅/메소/결정석 공통 슬롯을 쓴다.
		local kind = item.rewardType or ""
		if kind == "hero" then
			local heroId = item.heroId or ""
			local base = _HeroDataManager:GetHeroBaseData(heroId)
			local name = heroId
			local icon, localX, localY = "", 0, 0
			if base ~= nil then
				if base.Name ~= nil and base.Name ~= "" then name = base.Name end
				-- 로비 Center/HeroThumnail과 같은 이미지를 쓴다(= ThumnailRUID).
				-- CSV 컬럼명이 Thumnail(오타)이라 그대로 따른다. PortraitRUID는 쓰지 않는다.
				icon = base.ThumnailRUID or ""
				localX = base.LocalX or 0
				localY = base.LocalY or 0
			end
			-- 신규/중복은 표시하지 않는다(2026-09-04 사용자 결정). 등급만 노출한다.
			-- 서버가 보내는 isNew 값은 그대로 두었으니 나중에 필요하면 다시 쓸 수 있다.
			local rarity = tostring(item.rarity or "")
			return { name = name, sub = rarity, rarity = rarity, icon = icon, isHero = true, localX = localX, localY = localY }
		elseif kind == "meso" then
			local amount = tonumber(item.amount) or 0
			return { name = "메소", sub = "+" .. tostring(amount), rarity = "", icon = self.mesoIconRUID, isHero = false, localX = 0, localY = 0 }
		elseif kind == "stone" then
			local amount = tonumber(item.amount) or 0
			return { name = "결정석", sub = "+" .. tostring(amount), rarity = "", icon = self.stoneIconRUID, isHero = false, localX = 0, localY = 0 }
		elseif kind == "ticket" then
			-- ★5 중복 영웅을 서버가 티켓으로 바꿔 보낸 칸이다(`maxStarHeroId`에 출처가 남는다).
			-- 왜 티켓이 나왔는지 슬롯에서 바로 읽히도록 부제에 사유를 적는다.
			local amount = tonumber(item.amount) or 0
			local sub = "+" .. tostring(amount)
			if item.maxStarHeroId ~= nil and item.maxStarHeroId ~= "" then
				local base = _HeroDataManager:GetHeroBaseData(item.maxStarHeroId)
				local hname = (base ~= nil and base.Name ~= nil and base.Name ~= "") and base.Name or item.maxStarHeroId
				sub = tostring(hname) .. " ★5 +" .. tostring(amount)
			end
			return { name = "티켓", sub = sub, rarity = "", icon = self.ticketIconRUID, isHero = false, localX = 0, localY = 0 }
		end
		return { name = "", sub = "", rarity = "", icon = "", isHero = false, localX = 0, localY = 0 }
	end

	@ExecSpace("ClientOnly")
	method boolean IsAnyOpen()
		-- 결과창(1회/10연차)이나 확률 팝업이 하나라도 떠 있으면 true.
		if isvalid(self.panel1) and self.panel1.Enable then return true end
		if isvalid(self.panel10) and self.panel10.Enable then return true end
		if isvalid(self.probabilityPopup) and self.probabilityPopup.Enable then return true end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean TryBeginPull()
		-- 뽑기 버튼이 서버 요청 전에 호출한다. false면 요청하지 않는다.
		-- ① 팝업이 떠 있으면 차단 — 결과창 밖으로 삐져나온 버튼이 눌리는 것을 막는다.
		-- ② 응답 대기 중이면 차단 — 결과창은 응답 후에 뜨므로 왕복 사이 연타는 ①로 못 막는다.
		if self:IsAnyOpen() then
			log("[GachaResultUI] 팝업이 열려 있어 뽑기 요청을 막았습니다.")
			return false
		end
		local now = _UtilLogic.ElapsedSeconds
		if self._T.pending == true and (now - (self._T.pendingAt or 0)) < 5 then
			log("[GachaResultUI] 이전 뽑기 응답 대기 중 — 요청을 막았습니다.")
			return false
		end
		-- 5초 넘게 응답이 없으면 스스로 잠금을 푼다(응답 유실 시 영구 잠김 방지).
		self._T.pending = true
		self._T.pendingAt = now
		return true
	end

	@ExecSpace("ClientOnly")
	method void EndPull()
		-- 실패 응답을 받았을 때 잠금 해제. 성공은 Show()가 푼다.
		self._T.pending = false
	end

	@ExecSpace("ClientOnly")
	method void Show(any items)
		-- 뽑기 결과 표시. 1건이면 단일 패널, 그 외에는 10연차 그리드.
		self._T.pending = false   -- 응답이 왔으니 뽑기 잠금 해제
		if items == nil or #items == 0 then
			log_warning("[GachaResultUI] 표시할 결과가 없습니다.")
			return
		end
		self:Close()
		if #items == 1 then
			self:_ShowSingle(items[1])
		else
			self:_ShowMulti(items)
		end
	end

	@ExecSpace("ClientOnly")
	method void _ShowSingle(any item)
		local d = self:_Describe(item)
		self:_SetIcon(self.panel1, "Icon", d, 0.48, 230)
		self:_SetText(self.panel1, "NameText", d.name)
		self:_SetText(self.panel1, "SubText", d.sub)
		self.panel1.Enable = true
		log("[GachaResultUI] 1회 결과 표시 — " .. tostring(d.name) .. " (" .. tostring(d.sub) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void _ShowMulti(any items)
		local heroCount, meso, stone, ticket = 0, 0, 0, 0
		for i = 1, 10 do
			local slot = self:_Child(self.panel10, "Slot" .. tostring(i))
			if isvalid(slot) then
				local item = items[i]
				if item == nil then
					slot.Enable = false
				else
					slot.Enable = true
					local d = self:_Describe(item)
					self:_SetSlotFrame(slot, d)
					-- 영웅 아트 원본 세로가 약 1100px이라 0.17이면 약 187px — 슬롯 안에 들어간다.
					self:_SetIcon(slot, "Icon", d, 0.17, 100)
					self:_SetText(slot, "NameText", d.name)
					self:_SetText(slot, "SubText", d.sub)
				end
			end
		end
		for _, item in ipairs(items) do
			local kind = item.rewardType or ""
			if kind == "hero" then
				heroCount += 1
			elseif kind == "meso" then
				meso += (tonumber(item.amount) or 0)
			elseif kind == "stone" then
				stone += (tonumber(item.amount) or 0)
			elseif kind == "ticket" then
				ticket += (tonumber(item.amount) or 0)
			end
		end
		-- 하단 합계 문구는 표시하지 않는다(2026-09-04 사용자 결정). 집계는 로그로만 남긴다.
		self.panel10.Enable = true
		log("[GachaResultUI] 10연차 결과 표시 — 영웅 " .. tostring(heroCount)
			.. " 메소 " .. tostring(meso) .. " 결정석 " .. tostring(stone)
			.. " 티켓(★5중복) " .. tostring(ticket))
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self:_Hide(self.panel1)
		self:_Hide(self.panel10)
	end

	@ExecSpace("ClientOnly")
	method void ShowProbability()
		-- GachaSet/GachaConfigSet을 그대로 읽어 표시한다. CSV를 고치면 화면도 따라간다.
		if not isvalid(self.probabilityPopup) then return end

		local rows = {}
		local total = 0
		local count = _DataService:GetRowCount("GachaSet")
		for i = 1, count do
			if _DataService:GetCell("GachaSet", i, "BannerId") == "standard" then
				local w = tonumber(_DataService:GetCell("GachaSet", i, "Weight")) or 0
				if w > 0 then
					total += w
					table.insert(rows, {
						rewardType = _DataService:GetCell("GachaSet", i, "RewardType") or "",
						rarity     = _DataService:GetCell("GachaSet", i, "Rarity") or "",
						amount     = tonumber(_DataService:GetCell("GachaSet", i, "Amount")) or 0,
						weight     = w,
					})
				end
			end
		end

		-- 확률이 낮은 항목이 아래로 가도록 가중치 내림차순 정렬 (2026-09-04 사용자 요청).
		table.sort(rows, function(a, b) return a.weight > b.weight end)

		-- 행을 제목~보장문구 사이 영역(세로 500, 중심 y=60)에 균등 배치한다.
		-- 항목 수가 늘어도 넘치지 않도록 높이를 줄여 맞춘다.
		local n = #rows
		local gap = 14
		local h = 100
		if n > 0 then
			local fit = math.floor((500 - (n - 1) * gap) / n)
			if fit < h then h = fit end
		end
		-- 위쪽 가중치 합계 변수(total)와 이름이 겹치지 않게 할 것 — 겹치면 퍼센트가 픽셀값으로 나뉜다.
		local blockH = n * h + (n - 1) * gap
		local topY = 60 + blockH / 2 - h / 2

		for i = 1, 6 do
			local row = self:_Child(self.probabilityPopup, "Row" .. tostring(i))
			if isvalid(row) then
				local r = rows[i]
				if r == nil then
					row.Enable = false
				else
					row.Enable = true
					local t = row.UITransformComponent
					if t ~= nil then
						t.RectSize = Vector2(700, h)
						t.anchoredPosition = Vector2(0, topY - (i - 1) * (h + gap))
					end
					local label, icon
					if r.rewardType == "hero" then
						label = tostring(r.rarity) .. " 영웅"
						icon = self:_SampleHeroThumbnail(r.rarity)
					elseif r.rewardType == "meso" then
						label = "메소 " .. tostring(r.amount)
						icon = self.mesoIconRUID
					elseif r.rewardType == "stone" then
						label = "결정석 " .. tostring(r.amount)
						icon = self.stoneIconRUID
					else
						label = tostring(r.rewardType)
						icon = ""
					end
					local pct = 0
					if total > 0 then pct = r.weight * 100 / total end
					self:_SetIcon(row, "Icon", { icon = icon, isHero = (r.rewardType == "hero"), localX = 0, localY = 0 }, 0.07, 54)
					self:_SetText(row, "Label", label)
					self:_SetText(row, "Percent", string.format("%.1f%%", pct))
				end
			end
		end

		local guaranteed = ""
		local cfgCount = _DataService:GetRowCount("GachaConfigSet")
		for i = 1, cfgCount do
			if _DataService:GetCell("GachaConfigSet", i, "BannerId") == "standard" then
				local multi = _DataService:GetCell("GachaConfigSet", i, "MultiCount") or "10"
				if _DataService:GetCell("GachaConfigSet", i, "GuaranteedRewardType") == "hero" then
					guaranteed = multi .. "회 소환 시 영웅 1명 확정"
				end
				break
			end
		end
		-- 보장이 꺼져 있으면(GachaConfigSet의 GuaranteedRewardType 공란) 문구 자체를 숨긴다.
		self:_SetText(self.probabilityPopup, "NoteText", guaranteed)
		local note = self:_Child(self.probabilityPopup, "NoteText")
		if isvalid(note) then note.Enable = (guaranteed ~= "") end

		self.probabilityPopup.Enable = true
		log("[GachaResultUI] 확률 표시 — 항목 " .. tostring(#rows) .. "개, 가중치 합 " .. tostring(total))
	end

	@ExecSpace("ClientOnly")
	method void CloseProbability()
		self:_Hide(self.probabilityPopup)
	end

end
